---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "cn-variants",
  description = "Tiny, typed utilities for composing Tailwind CSS class names.",
} = Astro.props;

const pageTitle = title === "cn-variants" ? title : `${title} · cn-variants`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? Astro.url.origin);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "cn-variants",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  description,
  url: "https://bastianplsfix.github.io/cn-variants/",
  codeRepository: "https://github.com/bastianplsfix/cn-variants",
  license: "https://opensource.org/license/mit",
};

const links = [
  { label: "Docs", href: withBase("/docs/"), active: pathname.includes("/docs/") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cn-variants" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href={withBase("/llms.txt")} title="LLM index" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={withBase("/")} aria-label="cn-variants home">
          cn-variants
        </a>

        <nav aria-label="Main navigation">
          {
            links.map((link) => (
              <a href={link.href} aria-current={link.active ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
          <a href="https://github.com/bastianplsfix/cn-variants">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>cn-variants</span>
        <span>MIT licensed · ESM only</span>
      </div>
    </footer>
  </body>
</html>
