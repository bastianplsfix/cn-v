---
import CodeBlock from "../components/CodeBlock.astro";
import Layout from "../components/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docsHref = `${base}/docs/`;

const example = `import { cn, type Variant, variants } from "cn-variants";

const tone = variants({
  primary: "bg-indigo-600 text-white",
  danger: "bg-red-600 text-white",
});

type Tone = Variant<typeof tone>;

cn("rounded px-4", tone("primary"), className);`;
---

<Layout>
  <section class="hero">
    <h1>cn-variants</h1>
    <p class="hero-summary">
      Three runtime exports for Tailwind class names: <code>cn</code> merges classes and
      resolves conflicts, <code>variants</code> is a typed lookup for variant maps, and{" "}
      <code>createCn</code> builds a custom <code>cn</code>. That's the whole API.
    </p>
    <div class="actions">
      <a class="button primary" href={docsHref}>Documentation</a>
      <a class="button" href="https://www.npmjs.com/package/cn-variants">npm</a>
    </div>
  </section>

  <section class="home-section">
    <div class="section-grid">
      <h2 class="section-heading">Example</h2>
      <div class="section-content">
        <CodeBlock code={example} label="button.ts" />
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="section-grid">
      <h2 class="section-heading">API</h2>
      <div class="section-content">
        <ul class="primitive-list">
          <li>
            <h3>cn(...inputs)</h3>
            <p>Accepts every clsx input form and resolves Tailwind conflicts left to right.</p>
          </li>
          <li>
            <h3>variants(map)</h3>
            <p>A typed lookup function for one variant axis.</p>
          </li>
          <li>
            <h3>createCn(merge)</h3>
            <p>Builds a cn-style function around a custom tailwind-merge configuration.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="section-grid">
      <h2 class="section-heading">Notes</h2>
      <div class="section-content">
        <ul>
          <li>ESM-only, no CommonJS entry point.</li>
          <li>Tree-shakeable: importing <code>variants</code> alone does not pull in clsx or tailwind-merge in a bundler.</li>
          <li>No configuration objects. Defaults and compound conditions are ordinary JavaScript in your component.</li>
        </ul>
        <p><a href={`${docsHref}#design`}>Design decisions</a></p>
      </div>
    </div>
  </section>
</Layout>
