{
  "name": "cn-variants",
  "version": "3.0.0",
  "description": "Tiny utilities for working with Tailwind CSS class names. Combines clsx + tailwind-merge with a typed variants helper.",
  "keywords": [
    "classnames",
    "clsx",
    "cva",
    "tailwind",
    "tailwind-merge",
    "variant",
    "variants"
  ],
  "homepage": "https://cn-variants.com/",
  "bugs": {
    "url": "https://github.com/bastianplsfix/cn-variants/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastianplsfix/cn-variants.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "docs-install": "vp install",
    "docs": "vp run @cn-variants/playground#dev",
    "docs-stop": "vp run @cn-variants/playground#dev stop",
    "docs-status": "vp run @cn-variants/playground#dev status",
    "docs-check": "vp run @cn-variants/playground#check && vp run @cn-variants/ui#check",
    "docs-build": "vp run @cn-variants/playground#build",
    "docs-preview": "vp run @cn-variants/playground#preview",
    "test": "vp test run",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "vp exec tsc --noEmit",
    "check:package": "vp exec publint && vp exec attw --pack . --profile esm-only",
    "check:size": "node scripts/check-size.mjs",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^24.13.3",
    "clsx": "^2.1.1",
    "publint": "0.3.21",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "vite-plus": "0.2.5"
  },
  "peerDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.11.1"
}
