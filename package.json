{
  "name": "cn-variants",
  "version": "2.0.0",
  "description": "Tiny utilities for working with Tailwind CSS class names. Combines clsx + tailwind-merge with a typed variants helper.",
  "keywords": [
    "classnames",
    "clsx",
    "tailwind",
    "tailwind-merge",
    "variants"
  ],
  "homepage": "https://github.com/bastianplsfix/cn-variants#readme",
  "bugs": {
    "url": "https://github.com/bastianplsfix/cn-variants/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastianplsfix/cn-variants.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "vp exec tsc --noEmit",
    "check:package": "vp exec publint && vp exec attw --pack . --profile esm-only",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^24.13.3",
    "publint": "0.3.21",
    "typescript": "^5.9.3",
    "vite-plus": "0.2.5"
  },
  "packageManager": "npm@11.11.1"
}
